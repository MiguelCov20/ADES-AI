# API Keys
GOOGLE_API_KEY=tu_clave_de_api_de_gemini_aqui
OPENCODE_API_KEY=tu_clave_de_opencode_go

# Modelo Gemini para el Project Manager (configurable; ver AGENTS.md)
GEMINI_MODEL=gemini-flash-latest

# Conexiones a Memoria (Definidas en tu Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password_seguro_123

QDRANT_URL=http://localhost:6333
# --- v1.1 ---
# Enrutar todas las llamadas LLM por el gateway Bifrost (direct | bifrost)
ADES_GATEWAY=bifrost
BIFROST_VK_FACTORY=
BIFROST_VK_LOCAL=
# Timeout duro por llamada de nube (s) y umbral del caché semántico
ADES_LLM_TIMEOUT=120
ADES_SEMCACHE_THRESHOLD=0.95
# 0 = el self-healing nunca escala a modelos de nube
ADES_SELF_HEAL_CLOUD=1
# Graphiti en el timeline de decisiones (usa un LLM de pago por episodio)
ADES_TIMELINE_GRAPHITI=1
# Juez por defecto: council | (vacío = juez único)
ADES_JUDGE=

# Langfuse self-host (docker-compose.langfuse.yml); genera valores aleatorios
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_ORG_ID=ades
LANGFUSE_INIT_PROJECT_ID=ades-ai
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CH_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_AUTH=

# --- v1.2 ---
# Backend de modelos locales: ollama | llamacpp (llama-server con batching continuo, KPI 5).
# En Linux, la mejor opción es vLLM (environment/vllm/); Bifrost lo registra como proveedor "vllm".
ADES_LOCAL_BACKEND=llamacpp
ADES_LLAMACPP_BACKEND=rocm
# Voz: micrófono (índice o parte del nombre; por defecto la webcam) y modelo de whisper
ADES_MIC_DEVICE=
ADES_WHISPER_MODEL=small
