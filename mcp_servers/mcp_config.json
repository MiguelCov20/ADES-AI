{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\Miguel Dev\\Desktop\\Proyectos"],
      "enabled": true
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "enabled": true
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" },
      "enabled": true
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": { "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}" },
      "enabled": true
    },
    "cognee-mcp": {
      "url": "http://127.0.0.1:8001/sse",
      "transport": "sse",
      "command": "docker",
      "args": ["run", "-d", "--name", "cognee-mcp", "-p", "8001:8000", "-e", "TRANSPORT_MODE=sse", "cognee/cognee-mcp:main"],
      "enabled": true
    }
  }
}
